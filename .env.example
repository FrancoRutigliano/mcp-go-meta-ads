# Credenciales de Meta (obligatorias)
META_TOKEN=
META_AD_ACCOUNT_ID=act_
META_API_VERSION=v21.0

# Transporte
PORT=8080

# URL pública del servidor. Obligatoria si se habilita OAuth: de acá sale el
# resource identifier (PUBLIC_URL + /mcp) que debe venir en el claim `aud`.
PUBLIC_URL=

# Autenticación OAuth (recomendada). Es el único modo con el que el conector
# remoto de Claude puede autenticarse.
OAUTH_ISSUER=
OAUTH_REQUIRED_SCOPES=

# Bearer estático heredado. Sirve para acceso máquina a máquina; el conector de
# Claude NO puede usarlo. Vacío junto con OAUTH_ISSUER deja el endpoint abierto.
MCP_AUTH_TOKEN=
